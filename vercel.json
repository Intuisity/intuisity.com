{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/articles", "destination": "/api/article-page" },
    { "source": "/articles/category/:category", "destination": "/api/article-page?category=:category" },
    { "source": "/articles/:slug", "destination": "/api/article-page?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/article-page?sitemap=1" }
  ]
}

